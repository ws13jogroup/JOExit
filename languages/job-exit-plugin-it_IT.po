# Messaggi ironici per EXIT
msgid "It will be a great loss... or maybe not 😅"
msgstr "Sarà una grande perdita... o forse no 😅"

msgid "Another talent leaving... towards the exit! 😏"
msgstr "Un altro talento che se ne va... verso l'uscita! 😏"

msgid "Promotion pending... to the door! 😕"
msgstr "Promozione in sospeso... verso la porta! 😕"

msgid "Someone prepare the reference letter... very short! 😉"
msgstr "Qualcuno prepari la lettera di referenze... molto breve! 😉"

msgid "Their JOby is already deactivated! 😜"
msgstr "Il suo JOby è già disattivato! 😜"

msgid "Their desk is already free! 🙋"
msgstr "La sua scrivania è già libera! 🙋"

msgid "Goodbye, we won't miss you... much! 😊"
msgstr "Addio, non ci mancherai... molto! 😊"

msgid "This is why you should never get too attached to colleagues! 😂"
msgstr "Ecco perché non dovresti mai affezionarti troppo ai colleghi! 😂"

msgid "Let's see who will be next... 😈"
msgstr "Vediamo chi sarà il prossimo... 😈"

msgid "One less problem for the HR office! 😎"
msgstr "Un problema in meno per l'ufficio HR! 😎"

# Messaggi ironici per NOPE
msgid "Saved by a hair... this time! 🙌"
msgstr "Salvato per un pelo... questa volta! 🙌"

msgid "Survived for another day! 😍"
msgstr "Sopravvissuto per un altro giorno! 😍"

msgid "Their luck won't last forever... 😝"
msgstr "La sua fortuna non durerà per sempre... 😝"

msgid "Stays... for now! 😎"
msgstr "Rimane... per ora! 😎"

msgid "Today is their lucky day! 😉"
msgstr "Oggi è il suo giorno fortunato! 😉"

msgid "Escaped firing... for this time! 😁"
msgstr "Scampato al licenziamento... per questa volta! 😁"

msgid "Someone up there is protecting them! 😊"
msgstr "Qualcuno lassù lo sta proteggendo! 😊"

msgid "Will continue to occupy their desk... for now! 😬"
msgstr "Continuerà a occupare la sua scrivania... per ora! 😬"

msgid "Still safe... but we'll keep an eye on them! 🙂"
msgstr "Ancora al sicuro... ma lo terremo d'occhio! 🙂"

msgid "Avoided the worst... at least for today! 😏"
msgstr "Ha evitato il peggio... almeno per oggi! 😏"

